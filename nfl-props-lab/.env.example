# Copy to .env (never commit .env). Secrets are read server-side only.
# The Odds API key (https://the-odds-api.com/). Without it, odds features show "ROI unavailable".
ODDS_API_KEY=
# Optional: where data lives (default: ./data)
NPL_HOME=
# Optional: credits that every odds pull must leave unspent (default 400)
NPL_ODDS_FLOOR=
