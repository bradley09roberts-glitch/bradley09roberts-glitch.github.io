# Copy to .env and fill in. Never commit .env. Keys are read by the backend only;
# nothing here is exposed to the frontend or written to logs.

# Storage (defaults: data/footy.sqlite3 and data/ under the project root)
# FOOTY_DATABASE_URL=sqlite:///data/footy.sqlite3
# FOOTY_DATA_DIR=data

# Display and logging
FOOTY_DISPLAY_TZ=Europe/London
FOOTY_LOG_LEVEL=INFO

# football-data.co.uk: polite automatic download (DECISIONS.md D-013). Set false to use only
# hand-downloaded files in data/inbox/football-data/<season>_<division>.csv
FOOTY_FD_DOWNLOAD=true

# Live provider: none | sportmonks | api_football (chosen in DECISIONS.md; key supplied by the owner)
FOOTY_LIVE_PROVIDER=none
SPORTMONKS_API_TOKEN=
API_FOOTBALL_KEY=
