# /etc/caddy/Caddyfile, written by deploy/setup.sh from deploy/Caddyfile.template (re-run
# setup.sh to change it; edits here are overwritten). docs/server.md, "Operator".
#
# HTTPS for @HOST@ (Let's Encrypt; sslip.io resolves the name to this server's address, so
# no domain is needed), one password for everything, the built site from @SITE_DIR@, and
# /api and /media from the API on 127.0.0.1:8000 (it never listens on the internet).

@HOST@ {
	encode zstd gzip

	basic_auth {
		@AUTH_USER@ @AUTH_HASH@
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy 127.0.0.1:8000 {
			# the API sees itself addressed locally (it may only trust local host names)
			header_up Host 127.0.0.1:8000
		}
	}

	handle {
		root * @SITE_DIR@
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/footy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
