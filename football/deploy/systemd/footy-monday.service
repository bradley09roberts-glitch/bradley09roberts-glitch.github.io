# Installed by deploy/setup.sh (placeholders @...@ filled in); docs/server.md, "Operator".
[Unit]
Description=Football model: weekend results, settlement and the weekly summary, Monday 08:10 (deploy/jobs/monday.sh)
After=network-online.target
Wants=network-online.target
OnFailure=footy-failure@%n.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@PROJECT@
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PROJECT@/deploy/jobs/monday.sh
TimeoutStartSec=2h
NoNewPrivileges=true
Nice=5
PrivateTmp=true
ProtectSystem=full
