# Installed by deploy/setup.sh; times are UK time (Europe/London), summer or winter.
[Unit]
Description=Football model: results, settlement and new fixtures' records, daily 08:00

[Timer]
OnCalendar=*-*-* 08:00:00 Europe/London
Persistent=true
AccuracySec=1min
Unit=footy-daily.service

[Install]
WantedBy=timers.target
