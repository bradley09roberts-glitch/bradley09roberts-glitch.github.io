# Installed by deploy/setup.sh; times are UK time (Europe/London), summer or winter.
[Unit]
Description=Football model: weekend results, settlement and the weekly summary, Monday 08:10

[Timer]
OnCalendar=Mon *-*-* 08:10:00 Europe/London
Persistent=true
AccuracySec=1min
Unit=footy-monday.service

[Install]
WantedBy=timers.target
