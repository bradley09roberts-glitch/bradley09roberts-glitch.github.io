# Installed by deploy/setup.sh (placeholders @...@ filled in); docs/server.md, "Operator".
[Unit]
Description=Football model: Tuesday and Friday prices and model + market records, 12:40 (retries 14:20, 15:20) (deploy/jobs/prices.sh)
After=network-online.target
Wants=network-online.target
OnFailure=footy-failure@%n.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@PROJECT@
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PROJECT@/deploy/jobs/prices.sh
TimeoutStartSec=3h
NoNewPrivileges=true
Nice=5
PrivateTmp=true
ProtectSystem=full
