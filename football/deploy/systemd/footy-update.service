# Installed by deploy/setup.sh (placeholders @...@ filled in); docs/server.md, "Operator".
[Unit]
Description=Football model: weekly code update with a migration guard, Wednesday 04:00 (deploy/jobs/update.sh)
After=network-online.target
Wants=network-online.target
OnFailure=footy-failure@%n.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@PROJECT@
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PROJECT@/deploy/jobs/update.sh
TimeoutStartSec=1h
# sudo -n systemctl restart footy-api.service (sudoers.d/footy) needs privileges
NoNewPrivileges=false
Nice=5
PrivateTmp=true
ProtectSystem=full
