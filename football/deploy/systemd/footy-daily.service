# Installed by deploy/setup.sh (placeholders @...@ filled in); docs/server.md, "Operator".
[Unit]
Description=Football model: results, settlement and new fixtures' records, daily 08:00 (deploy/jobs/daily.sh)
After=network-online.target
Wants=network-online.target
OnFailure=footy-failure@%n.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@PROJECT@
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@PROJECT@/deploy/jobs/daily.sh
TimeoutStartSec=3h
NoNewPrivileges=true
Nice=5
PrivateTmp=true
ProtectSystem=full
