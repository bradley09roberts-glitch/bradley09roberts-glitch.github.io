{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Odile",
    "color": "gold",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "A woman with a lantern walks the lanes some nights. She never stops. She never answers."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "If she's yours, you'll want to keep her lamp lit. Things that go dark here don't come back on their own."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"Then help me find her.\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1004"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "exit_action": {
    "label": {
      "text": "Back"
    },
    "width": 200
  }
}
