{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Brannoc",
    "color": "yellow",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "The woman with the lantern. Slept in my barn. Asked about my brother. I told her to mind her business."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "She went on north. They all go north, in the end."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"What does the orchard need?\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1017"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "exit_action": {
    "label": {
      "text": "Back"
    },
    "width": 200
  }
}
