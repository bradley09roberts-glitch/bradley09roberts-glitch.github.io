{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Odile",
    "color": "gold",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "The Deepcut fell. The stillglass mine, up under the north cliffs. They rang the bells for hours, calling everyone to dig."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "And the Keeper's great light out on the Meridian went dark that same night. Then the fog came in off the water, and it never went home."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"And Tamsin?\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1010"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close"
}
