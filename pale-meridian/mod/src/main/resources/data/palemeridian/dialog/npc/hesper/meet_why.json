{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Hesper Vane",
    "color": "dark_aqua",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Let it? I made it. A chart is a promise to look. I broke mine."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "After that the looking stopped everywhere, a little at a time, like a tide going out."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"Why break it?\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1031"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "exit_action": {
    "label": {
      "text": "Back"
    },
    "width": 200
  }
}
