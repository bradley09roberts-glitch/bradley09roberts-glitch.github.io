{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Odile",
    "color": "gold",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Help Hollin remember, then. Places keep what people drop."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "The bakery. The well in the square. The hall. The ferry steps down by the water. They all had names once. Walk into them. Listen."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "And keep your light up. The fog is cold, and it isn't only cold."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"I'll listen.\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1007"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close"
}
