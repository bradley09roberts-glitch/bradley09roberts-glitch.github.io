  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "The Round! Oh, I know this. It goes..."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Bread for the morning, water for noon, words for the evening, the ferry for home."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Every family kept a bell, you see, and every family kept a place. We rang them in the order of the day."
      },
      "width": 320
    }
