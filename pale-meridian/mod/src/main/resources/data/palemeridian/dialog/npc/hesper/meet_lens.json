{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Hesper Vane",
    "color": "dark_aqua",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "The Great Lens gathers the valley into one image, and the Long Chart keeps it. Set a new heart in it and it will see everything again. Every field. Every name. Even him."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "I will not stop you. I only ask you to think about what a blank is for."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"I have to light it.\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1034"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "exit_action": {
    "label": {
      "text": "Not yet"
    },
    "width": 200
  }
}
