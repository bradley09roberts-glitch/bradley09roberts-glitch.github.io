{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Brannoc",
    "color": "yellow",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Roots are gone. I heard them go."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Col made that lamp for the mill, the year before. Take it up. Four lanterns round it and the honeycomb blocks either side, the way he had it."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Take Col's lamp"
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1019"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "exit_action": {
    "label": {
      "text": "Not yet"
    },
    "width": 200
  }
}
