{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Hesper Vane",
    "color": "dark_aqua",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Yes. With this hand. I sat where you are standing and painted over the cliffs until the paper was white."
      },
      "width": 320
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Then I put out the Lens, so that it would never see what I had done."
      },
      "width": 320
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "\"Why?\""
      },
      "width": 300,
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger pm.talk set 1032"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "exit_action": {
    "label": {
      "text": "Back"
    },
    "width": 200
  }
}
