{
  "type": "minecraft:notice",
  "title": {
    "text": "Something of Hers",
    "color": "aqua"
  },
  "external_title": {
    "text": "Objective"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Show Tamsin three things that are hers.",
        "color": "white"
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Tamsin has faded like the others. She might remember herself if she sees things that belong to her.",
        "color": "gray"
      },
      "width": 300
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Hint: Her letter (the noticeboard at the Landing keeps a copy), her field notes (her camp in the Aldercross cider-press loft) and her theodolite (the Glassworks office).",
        "color": "dark_aqua",
        "italic": true
      },
      "width": 300
    }
  ],
  "action": {
    "label": {
      "text": "Back to the journal"
    },
    "action": {
      "type": "minecraft:run_command",
      "command": "/trigger pm.ui set 1"
    }
  }
}
