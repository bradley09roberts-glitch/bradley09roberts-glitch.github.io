execute if items entity @s container.* *[minecraft:custom_data~{pm:{item:"field_notes"}}] run return run tellraw @s {"text":"You already carry Tamsin's field notes.","color":"gray"}
give @s minecraft:written_book[minecraft:written_book_content={"title":{"raw":"Field Notes"},"author":"T. Reed","pages":[{"raw":[{"text":"FIELD NOTES\n","bold":true},{"text":"T. Reed, Chartered Survey\nVale of Vell\n\n","color":"dark_gray","italic":true},{"text":"The fog is not weather. It does not move with the wind. It pools where people stop looking.","color":"black"}]},{"raw":[{"text":"Hollin: they've forgotten their names but not their chores. Habit outlasts memory. The lamplighter lights one lamp. Why that one?","color":"black"}]},{"raw":[{"text":"The locals' creatures: Watchers. They freeze when seen. Of course they do. Everything here does.","color":"black"}]},{"raw":[{"text":"Stillglass: lakebed mineral, holds light (and, I think, attention). The Keeper's Lens on the Meridian gathered the whole valley through it.\n\nSomeone turned the Lens off.","color":"black"}]},{"raw":[{"text":"Going north to the Glassworks. The old Chart shows a blank under the cliffs.\n\nBlanks are never accidents.\n\n— T.","color":"black"}]}],"resolved":true},minecraft:custom_data={"pm":{"item":"field_notes"}},minecraft:lore=[{"text":"Tamsin's handwriting, small and fast.","italic":false,"color":"gray"}]] 1
