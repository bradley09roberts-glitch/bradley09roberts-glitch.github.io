# Keeps the forged pieces available: the lamp until it is built, the Lens Heart until it is set in the Lens.
execute unless block 0 99 -308 minecraft:pearlescent_froglight unless items block 12 70 -295 container.* minecraft:pearlescent_froglight unless entity @a[predicate=palemeridian:holds_stillglass] run item replace block 12 70 -295 container.12 with minecraft:pearlescent_froglight[minecraft:custom_name={"text":"Stillglass Lamp","italic":false,"color":"aqua"}] 1
execute unless score c4.lens pm.q matches 2 unless items block 12 70 -295 container.* *[minecraft:custom_data~{pm:{item:"lens_heart"}}] unless entity @a[predicate=palemeridian:holds_lens_heart] run item replace block 12 70 -295 container.14 with minecraft:heart_of_the_sea[minecraft:custom_name={"text":"Lens Heart","italic":false,"color":"aqua"},minecraft:lore=[{"text":"Stillglass, forged in Kiln Three.","italic":false,"color":"gray"},{"text":"It is cold, and it looks back.","italic":false,"color":"gray"}],minecraft:custom_data={pm:{item:"lens_heart"}}] 1
