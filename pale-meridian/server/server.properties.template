# Pale Meridian - server.properties defaults. Copied only when no server.properties exists yet.
# Private by design: whitelist on, official account authentication on, remote administration off.
motd=Pale Meridian - a story of the Vale of Vell
level-name=world
# Must stay on the default world type: the valley is generated by the Pale Meridian mod.
level-type=minecraft\:normal
online-mode=true
enforce-secure-profile=true
white-list=true
enforce-whitelist=true
max-players=4
difficulty=normal
gamemode=survival
# 0 so every player (not only operators) can build near spawn: the first lamp is at the spawn point.
spawn-protection=0
view-distance=10
simulation-distance=8
allow-flight=false
generate-structures=true
server-port=25565
enable-rcon=false
enable-query=false
management-server-enabled=false
pause-when-empty-seconds=60
sync-chunk-writes=true
